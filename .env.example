# Copy this file to .env (for local `vercel dev`) — never commit the real .env.
# In production, set these in the Vercel dashboard instead of a file:
# Project → Settings → Environment Variables.

# Required. Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
# This is read ONLY by api/agent.js on the server — it is never sent to the browser.
GEMINI_API_KEY=your-gemini-key-here

# Optional. Overrides which Gemini model api/agent.js calls. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
